# Django
DJANGO_SECRET_KEY=replace-this-with-a-long-random-value
DJANGO_DEBUG=True
# Enable for an HTTPS deployment with DJANGO_DEBUG=False.
DJANGO_SECURE_HTTPS=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_LOG_LEVEL=INFO

# PostgreSQL (keep these values in sync with docker-compose.yml)
POSTGRES_DB=hotel_booking
POSTGRES_USER=hotel_booking
POSTGRES_PASSWORD=change-this-local-password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
